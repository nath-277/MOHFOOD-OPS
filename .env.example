# ==========================================
# MOH FOODS NG (MOH-OPS) - ENVIRONMENT CONFIG
# ==========================================

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (NeonDB Serverless PostgreSQL)
# Get your connection string from https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:[PASSWORD]@[HOST]/moh_ops?sslmode=require

# Cloudflare R2 Object Storage (For Waybills, Invoices & Photos)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=moh-foods-documents
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://documents.mohfood.com

# Authentication & Session Security
# Generate random 32+ character secrets (e.g. `openssl rand -hex 32`)
AUTH_SECRET=your_32_character_minimum_random_secret_here
AUTH_COOKIE_NAME=moh_ops_session
AUTH_SESSION_EXPIRY_DAYS=7

# Seed Admin Initial Credentials
INITIAL_ADMIN_EMAIL=admin@mohfood.com
INITIAL_ADMIN_PASSWORD=ChangeThisSecurePassword123!
INITIAL_ADMIN_PIN=1234
